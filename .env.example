# 复制为 .env 后填入自己的 token；.env 已在 .gitignore 里，不要提交。
# 也可以不填：Kaggle 会退回 ~/.kaggle/access_token，HF 会退回登录态。

# Kaggle：Settings -> API -> Create New Token，值形如 KGAT_xxx
KAGGLE_API_TOKEN=

# Hugging Face：https://huggingface.co/settings/tokens
# 下载 gemma 这类 gated 模型必须填
HF_TOKEN=

# 国内拉模型走镜像；不需要就删掉或留空
HF_ENDPOINT=https://hf-mirror.com
